HOST=127.0.0.1
PORT=4317
APP_ORIGIN=http://127.0.0.1:4317
# Obligatorio (mínimo 24 caracteres) si HOST no es loopback.
APP_ACCESS_TOKEN=
ENABLE_PRODUCTION_WRITES=false

# Las conexiones se crean desde Nueva conexión. No se cargan perfiles por entorno.
# Directorio privado para las conexiones cifradas (opcional). Evita carpetas sincronizadas.
# Por defecto: %LOCALAPPDATA%/ScotiaCompass o ~/.local/share/ScotiaCompass.
# SCOTIA_DATA_DIR=/ruta/privada/scotia-compass
